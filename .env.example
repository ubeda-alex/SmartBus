# Copiá este archivo como .env y completalo. El archivo .env no se sube a git.
# Sin ninguna clave, el MVP funciona igual con reglas y plantillas.

# Proveedor del modelo de lenguaje: ollama | gemini | groq | anthropic
SMARTBUS_PROVIDER=gemini
GEMINI_API_KEY=

